{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carpeta.local/contracts/visual-review.schema.json",
  "title": "Independent vision review binding",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "vision_verified", "reviewer", "figures"],
  "properties": {
    "version": {"const": 1},
    "vision_verified": {"const": true},
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "capability", "independent"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "capability": {"const": "vision"},
        "independent": {"const": true}
      }
    },
    "figures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scene_id", "attempt", "status", "inspected", "scores", "issues"],
        "properties": {
          "scene_id": {"type": "string", "minLength": 1},
          "attempt": {"type": "integer", "minimum": 1, "maximum": 3},
          "status": {"enum": ["pass", "fail"]},
          "inspected": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["variant", "file", "sha256"],
              "properties": {
                "variant": {"enum": ["wide", "narrow"]},
                "file": {"type": "string", "minLength": 1},
                "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
              }
            }
          },
          "scores": {"type": "object"},
          "issues": {"type": "array"}
        }
      }
    }
  }
}
